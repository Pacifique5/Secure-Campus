# Production Environment Variables for Render

# Database - Get this from Render PostgreSQL Dashboard (Internal Database URL)
DATABASE_URL="postgresql://user:password@host:5432/database"

# JWT Configuration - Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-this-to-random-64-char-string"
JWT_EXPIRES_IN="7d"

# Server Configuration
PORT=3001
NODE_ENV="production"

# Frontend URL - Your Vercel deployment URL
FRONTEND_URL="https://your-app.vercel.app"
